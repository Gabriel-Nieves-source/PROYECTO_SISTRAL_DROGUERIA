# Copie este archivo como backend/.env  (el .env NUNCA se sube a GitHub)

# Clave para firmar los tokens JWT (mínimo 32 caracteres). Genérela con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SITRAL_JWT_SECRET=

# Conexión a MySQL: usuario:contraseña@servidor/base  (el @ de la contraseña se escribe %40)
SITRAL_DATABASE_URL=mysql+pymysql://root:CONTRASENA@localhost/SITRAL

# Orígenes que pueden consumir la API (separados por coma).
# Para usarlo desde el celular agregue http://TU_IP:5500
SITRAL_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# true = Swagger en /docs (desarrollo). En producción: false
SITRAL_DEBUG=true

SITRAL_JWT_EXPIRE_MINUTES=60
SITRAL_SQL_ECHO=false
