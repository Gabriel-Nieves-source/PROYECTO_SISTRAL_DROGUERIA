# Copie este archivo como .env (el .env NUNCA se sube a GitHub)
# Genere el secreto con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SITRAL_JWT_SECRET=
SITRAL_JWT_EXPIRE_MINUTES=30
# Para probar rápido (sin MySQL) se usa SQLite; para MySQL use la línea comentada
SITRAL_DATABASE_URL=sqlite:///./sitral_dev.db
# SITRAL_DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3306/sitral
SITRAL_CORS_ORIGINS=["http://localhost:5173"]
SITRAL_DEBUG=true
